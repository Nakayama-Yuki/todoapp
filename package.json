{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:db": "node --test tests-db/*.test.mjs",
    "test:security": "playwright test --config=playwright.security.config.ts",
    "docker:dev": "docker-compose -f docker-compose.dev.yml --env-file .env up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml --env-file .env up -d --build",
    "dev:down": "docker-compose -f docker-compose.dev.yml down",
    "prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "docker:ps": "docker-compose -f docker-compose.dev.yml ps",
    "prod:ps": "docker-compose -f docker-compose.prod.yml ps",
    "postgres:up": "docker-compose -f docker-compose.dev.yml --env-file .env up -d postgres",
    "postgres:logs": "docker-compose -f docker-compose.dev.yml logs postgres",
    "test:e2e": "playwright test",
    "ci:check": "pnpm typecheck && pnpm lint --max-warnings=0"
  },
  "dependencies": {
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "packageManager": "pnpm@12.21.0"
}
